extends: default
rules:
  line-length:
    max: 140
    level: warning
  document-start: disable
  truthy:
    check-keys: false
  comments:
    min-spaces-from-content: 1
  braces:
    max-spaces-inside: 1
  indentation:
    spaces: 2
    indent-sequences: consistent
ignore: |
  deploy/.overlay-local/
