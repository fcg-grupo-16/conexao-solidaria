  },
  "item": [
    {
      "name": "1. Usuários",
      "item": [
        {
          "name": "Cadastrar doador (público)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{usuariosUrl}}/api/usuarios",
              "host": [
                "{{usuariosUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            },
            "description": "Cadastro público: e-mail único, CPF validado, senha com BCrypt. Todo cadastro público recebe o perfil Doador.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeCompleto\": \"Maria da Silva\",\n  \"email\": \"{{doadorEmail}}\",\n  \"cpf\": \"{{doadorCpf}}\",\n  \"senha\": \"{{doadorSenha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Doador novo a cada execução: e-mail e CPF válido aleatórios.",
                  "function digito(base, peso) {",
                  "  let soma = 0;",
                  "  for (let i = 0; i < base.length; i++) soma += Number(base[i]) * (peso - i);",
                  "  const resto = soma % 11;",
                  "  return resto < 2 ? 0 : 11 - resto;",
                  "}",
                  "let base = '';",
                  "for (let i = 0; i < 9; i++) base += Math.floor(Math.random() * 10);",
                  "const d1 = digito(base, 10);",
                  "const d2 = digito(base + d1, 11);",
                  "const cpf = base + d1 + d2;",
                  "pm.collectionVariables.set('doadorCpf', `${cpf.slice(0,3)}.${cpf.slice(3,6)}.${cpf.slice(6,9)}-${cpf.slice(9)}`);",
                  "pm.collectionVariables.set('doadorEmail', `doador.${Date.now()}@exemplo.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('perfil Doador', () => pm.expect(pm.response.json().perfil).to.eql('Doador'));"
                ]
              }
            }
          ]
        }
      ]
    },
