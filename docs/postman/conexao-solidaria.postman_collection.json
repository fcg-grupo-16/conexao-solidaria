              "raw": "{\n  \"titulo\": \"Natal Solidário\",\n  \"descricao\": \"Brinquedos e cestas para as crianças acolhidas pela ONG.\",\n  \"dataInicio\": \"{{dataInicio}}\",\n  \"dataFim\": \"{{dataFim}}\",\n  \"metaFinanceira\": 5000.0,\n  \"status\": \"Ativa\"\n}",
