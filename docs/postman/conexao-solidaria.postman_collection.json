              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// DataFim precisa estar no futuro (regra do PDF).",
                  "const agora = new Date();",
                  "pm.collectionVariables.set('dataInicio', new Date(agora.getTime() - 60 * 1000).toISOString());",
                  "pm.collectionVariables.set('dataFim', new Date(agora.getTime() + 30 * 24 * 3600 * 1000).toISOString());"
